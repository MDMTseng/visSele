{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 19, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "mac-arm64",
      "inherits": "base",
      "displayName": "macOS arm64 (dev)",
      "cacheVariables": {
        "FEATURE_ARAVIS": "ON",
        "FEATURE_MINDVISION": "OFF",
        "FEATURE_HIKROBOT": "OFF"
      }
    },
    {
      "name": "linux-x64",
      "inherits": "base",
      "displayName": "Linux x86_64 (native)",
      "cacheVariables": {
        "FEATURE_ARAVIS": "ON",
        "FEATURE_MINDVISION": "OFF",
        "FEATURE_HIKROBOT": "OFF"
      }
    },
    {
      "name": "mac-arm64-opencv",
      "inherits": ["mac-arm64", "vcpkg"],
      "displayName": "macOS arm64 + OpenCV via vcpkg"
    },
    {
      "name": "win-mingw",
      "inherits": ["base", "vcpkg"],
      "displayName": "Windows MSYS2/MinGW (deploy)",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "FEATURE_ARAVIS": "OFF",
        "FEATURE_MINDVISION": "ON",
        "FEATURE_HIKROBOT": "ON"
      }
    },
    {
      "name": "win-mingw-ninja",
      "inherits": "win-mingw",
      "displayName": "Windows MSYS2/MinGW + Ninja (compile-time profiling)",
      "generator": "Ninja"
    },
    {
      "name": "win-mingw-cross",
      "inherits": ["base", "vcpkg"],
      "displayName": "Windows x86_64 cross-compile from macOS (mingw-w64)",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic",
        "VCPKG_HOST_TRIPLET": "arm64-osx",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-mingw64.cmake",
        "X_VCPKG_APPLOCAL_DEPS_INSTALL": "OFF",
        "VCPKG_APPLOCAL_DEPS": "OFF",
        "FEATURE_ARAVIS": "OFF",
        "FEATURE_MINDVISION": "OFF",
        "FEATURE_HIKROBOT": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "mac-arm64", "configurePreset": "mac-arm64" },
    { "name": "mac-arm64-opencv", "configurePreset": "mac-arm64-opencv" },
    { "name": "linux-x64", "configurePreset": "linux-x64" },
    { "name": "win-mingw", "configurePreset": "win-mingw" },
    { "name": "win-mingw-ninja", "configurePreset": "win-mingw-ninja" },
    { "name": "win-mingw-cross", "configurePreset": "win-mingw-cross" }
  ]
}
