# build bundle (artifacts)
InspectionCore/dist/

# archived debug symbols split from Release bundles (per-build .debug files)
InspectionCore/symbols/

# logctrl daemon runtime outputs
insp.log
insp.log.*
crash_*.dump

# Windows minidumps from the SetUnhandledExceptionFilter handler. Only useful
# against the exact exe that produced them, and a few MB each. What matters
# from a crash -- exception code, RIP module offset, the symbolized frames --
# belongs in the write-up, not in the tree.
insp_crash_*.dmp

# On-demand log snapshot: fixed name, rewritten every time the operator
# presses 傾印核心日誌. 8-9MB of churn per press, and it is never a source file.
latest_dump.dump

# v2 app assembly output (make v2_app) -- a build product, not a source
export_v2/
# scratch log from a hand-run core
InspectionCore/Core0_1/core.log
UI/Launcher/release-builds

# Bench soak artefacts -- outputs, not sources. The tools that make them are
# tracked; the megabytes of samples they produce are not.
UI/WebUI/dist-soak/
UI/WebUI/tools/webctl/soak_logs/
UI/WebUI/tools/webctl/soak_auto.jsonl
UI/WebUI/tools/webctl/proc_track.json
UI/WebUI/tools/webctl/compare_throttle.json

# Crash dumps written by the running core, one folder per day. Outputs, and
# large ones -- 31MB on this bench after a week. The analysis belongs in a
# write-up; the dumps do not belong in the tree.
InspectionCore/Core0_1/crash_reports/

# A 73MB blob of sample data that was tracked once and should not have been.
# Deleted from the tree here; the history still carries it.
InspectionCore/Core0_1/data.zip

# Working directory created by samples/bringup/run.sh -- a machine's own state,
# same reason data/ is ignored.
samples/bringup/run/

# ...but samples/bringup/data/ IS the sample, not a machine's state, and the
# bare `data` rule near the top of this file matches a directory of that name at
# ANY depth. It silently swallowed the whole bring-up dataset out of the commit
# that added it: the tree looked complete locally and a fresh clone got run.sh
# and frames/ with nothing to run them on.
!samples/bringup/data/
!samples/bringup/data/**
